# Akademin (the sales training portal, ../utbildning) — where a saljare who hasn't
# passed the voice-AI milestone (level 14) gets redirected instead of into the CRM.
# See src/hooks/use-training-gate.ts. Defaults to the local dev server if unset.
VITE_UTBILDNING_URL=""

# AI (OpenAI, direct — replaces Lovable's AI gateway)
OPENAI_API_KEY=""

# Twilio (SMS booking reminders — direct, replaces Lovable's connector gateway)
TWILIO_ACCOUNT_SID=""
TWILIO_API_KEY=""
TWILIO_FROM_NUMBER=""

# Semrush (SEO data — direct, replaces Lovable's connector gateway)
SEMRUSH_API_KEY=""

# Google Search Console — PAUSED (see src/lib/gsc.server.ts). Needs a real
# Google OAuth2 setup (client id/secret + refresh token), not just an API key.
GOOGLE_SEARCH_CONSOLE_API_KEY=""

# Google Analytics 4 measurement ID (client-side tag only — the GA4 Data API
# for reports needs GA4_PROPERTY_ID + GA4_ACCESS_TOKEN below, not this)
VITE_GA4_MEASUREMENT_ID=""
GA4_PROPERTY_ID=""
GA4_ACCESS_TOKEN=""

# Email (Resend, direct — replaces Lovable's managed email API)
RESEND_API_KEY=""
# Signing secret Resend shows you for the webhook endpoint (Webhooks -> Add Endpoint,
# pointed at /api/hooks/resend-events) -- subscribe it to at least email.bounced and
# email.complained.
RESEND_WEBHOOK_SECRET=""
# Secret configured in Supabase Dashboard -> Authentication -> Hooks -> "Send Email"
# hook, pointed at /api/hooks/supabase-auth-email
